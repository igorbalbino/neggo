<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive files.
    RewriteRule "(^|/)\.(env|git|svn)" - [F,L,NC]
    RewriteRule "(^|/)(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.(js|ts))$" - [F,L,NC]

    # Block direct access to non-public application folders.
    RewriteRule "^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$)" - [F,L,NC]

    # Redirect all requests to /public.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$)
</IfModule>

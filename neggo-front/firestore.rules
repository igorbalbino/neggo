rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isParticipant(chatData) {
      return chatData.users.hasAny([request.auth.uid]);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Chat Rooms
    match /chats/{chatId} {
      allow read: if isSignedIn() && isParticipant(resource.data);
      
      allow create: if isSignedIn() 
        && request.resource.data.users.hasAny([request.auth.uid])
        && request.resource.data.contractor_id == request.auth.uid;
        
      allow update: if isSignedIn() && isParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['last_message', 'last_message_at', 'updatedAt', 'contractor_unread_count', 'artist_unread_count']);
    }

    // Messages
    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn() && isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);
      
      allow create: if isSignedIn() 
        && isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
        && request.resource.data.senderId == request.auth.uid;
    }
  }
}
